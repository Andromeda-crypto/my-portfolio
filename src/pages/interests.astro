---
import BaseLayout from "../layouts/BaseLayout.astro";
import { interests, links } from "../data/siteContent";
---

<BaseLayout
  title="A little further afield | Om Anand"
  description="Books, sport, and a few interests away from the workbench. A personal note from Om Anand."
  bodyClass="interests-page"
>
  <div class="page-frame">
    <div class="interests-letter">
      <header class="letter-intro">
        <p class="court-label">A little about the person</p>
        <h1>
          A little further
          <br />
          afield.
        </h1>
        <p class="letter-intro__copy">
          Books I’m spending time with, games I return to, and a few ways I
          enjoy being away from the desk.
        </p>
      </header>

      <section
        class="letter-section"
        id="reading"
        aria-labelledby="reading-heading"
      >
        <p class="court-label">01 / Reading</p>
        <h2 id="reading-heading">On the reading table.</h2>
        <article
          class="letter-current"
          aria-labelledby="current-reading-heading"
        >
          <h3 class="court-label" id="current-reading-heading">
            Currently reading
          </h3>
          <ul class="letter-books">
            {interests.reading.current.map((book) => (
              <li>
                <h4>{book.title}</h4>
                <p class="letter-author">{book.author}</p>
              </li>
            ))}
          </ul>
        </article>

        <div class="letter-favourites" aria-labelledby="favourites-heading">
          <h3 class="court-label" id="favourites-heading">
            My favourite
          </h3>
          <ul class="letter-books">
            {interests.reading.favorites.map((book) => (
              <li>
                <h4>{book.title}</h4>
                <p class="letter-author">{book.author}</p>
                <p class="letter-book-note">{book.note}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section
        class="letter-section"
        id="playing"
        aria-labelledby="playing-heading"
      >
        <p class="court-label">02 / Sport &amp; games</p>
        <h2 id="playing-heading">A life in motion.</h2>
        <div class="letter-sports">
          {interests.sports.map((sport) => (
            <article class="letter-sport">
              <h3>{sport.title}</h3>
              <p>{sport.description}</p>
              {sport.title === "Chess" && (
                <a
                  class="court-link"
                  href={links.chessCom}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Find me on Chess.com ↗
                </a>
              )}
            </article>
          ))}
        </div>
      </section>

      <section class="letter-closing" aria-labelledby="shared-interest-heading">
        <h2 id="shared-interest-heading">Something in common?</h2>
        <a class="court-link" href={links.email}>
          Say hello ↗
        </a>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .interests-letter {
    max-width: 720px;
    margin-inline: auto;
    padding-bottom: 3rem;
  }
  .letter-intro {
    padding-top: 9.5rem;
    padding-bottom: 3.5rem;
  }
  .letter-intro h1 {
    font-size: clamp(3rem, 6vw, 4.75rem);
    margin: 1.2rem 0 1.6rem;
  }
  .letter-intro__copy {
    font-family: var(--font-display);
    font-size: 1.5rem;
    max-width: 43ch;
  }
  .letter-section {
    border-top: var(--border-thin);
    padding-top: 2rem;
    margin-top: 2rem;
  }
  .letter-section > h2 {
    font-size: clamp(2rem, 4vw, 2.4rem);
    margin: 0.8rem 0 2rem;
  }
  .letter-current {
    border-left: 2px solid var(--color-terracotta);
    margin-block: 1rem 2.5rem;
    padding: 0.5rem 0 0.5rem 1.5rem;
  }
  /* These small headings identify book lists rather than introduce new display sections. */
  :global(html[data-theme]) .letter-current > h3,
  :global(html[data-theme]) .letter-favourites > h3 {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }
  .letter-books li + li {
    margin-top: 1.5rem;
  }
  .letter-current h4 {
    font-size: clamp(1.8rem, 3.5vw, 2.15rem);
    max-width: 30ch;
    margin: 0.9rem 0 0.6rem;
  }
  .letter-author {
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }
  .letter-favourites .letter-books {
    margin-top: 1rem;
  }
  .letter-favourites li {
    border-top: var(--border-thin);
    padding-block: 1.5rem 2rem;
  }
  .letter-favourites h4 {
    font-size: 1.8rem;
    margin-bottom: 0.6rem;
  }
  .letter-book-note {
    max-width: 58ch;
    margin-top: 1.1rem;
    font-size: 1rem;
  }
  .letter-sport {
    border-top: var(--border-thin);
    padding-block: 1.8rem;
  }
  .letter-sport h3 {
    font-size: 2rem;
    margin-bottom: 0.9rem;
  }
  .letter-sport:first-child h3 {
    font-size: 2.4rem;
  }
  .letter-sport p {
    max-width: 64ch;
    font-size: 1rem;
  }
  .letter-sport .court-link {
    margin-top: 1rem;
  }
  .letter-closing {
    border-top: var(--border-thin);
    padding-block: 2.5rem 1rem;
  }
  .letter-closing h2 {
    font-size: 1.8rem;
    margin-bottom: 1rem;
  }
  @media (max-width: 650px) {
    .interests-letter {
      padding-bottom: 1.5rem;
    }
    .letter-intro {
      padding-top: 8rem;
      padding-bottom: 2.5rem;
    }
    .letter-intro h1 {
      font-size: 2.8rem;
    }
    .letter-intro__copy {
      font-size: 1.375rem;
    }
    .letter-current {
      padding-left: 1.2rem;
    }
    .letter-current h4 {
      font-size: 1.8rem;
    }
    .letter-sport h3 {
      font-size: 1.85rem;
    }
    .letter-sport:first-child h3 {
      font-size: 2.1rem;
    }
  }
</style>
