    letter-spacing: var(--tracking-display);
    text-transform: uppercase;
  }

  .case-hero__summary {
    display: grid;
    grid-template-columns: minmax(0, 42rem) auto;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-7);
    margin-top: var(--space-8);
  }

